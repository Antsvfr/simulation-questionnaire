{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ile-des-agents/operations/garde.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ile-des-agents/operations/ile.py\" capteur session"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ile-des-agents/.claude/hooks/etat-ile.py\" debut"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ile-des-agents/.claude/hooks/etat-ile.py\" fin"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ile-des-agents/forge/inspection.sh\" --hook"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ile-des-agents/.claude/hooks/etat-ile.py\" repos"
          }
        ]
      }
    ]
  }
}
